{
  "name": "OpenSunstar",
  "version": "1.2.3",
  "description": "All-in-One Assistant for Claude Code, Codex & Gemini CLI",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "website:dev": "npx --yes serve website -l 3000",
    "website:publish": "node scripts/website-publish.mjs",
    "brand:sync": "python scripts/sync-brand-assets.py && pnpm tauri icon app-icon.png",
    "release:bump": "node scripts/release-bump.mjs",
    "release:sync-os-cli": "node scripts/sync-os-cli-version.mjs",
    "release:tag": "bash scripts/release-tag.sh",
    "release:tag:win": "powershell -ExecutionPolicy Bypass -File scripts/release-tag.ps1",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "os-cli:checksums": "node scripts/update-os-cli-checksums.mjs",
    "os-cli:verify": "node scripts/verify-os-cli-package.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:list": "node scripts/i18n-check.mjs --list-missing",
    "i18n:check:strict": "node scripts/i18n-check.mjs --strict --list-missing",
    "i18n:baseline": "node scripts/i18n-check.mjs --write-baseline",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:sync:check": "node scripts/i18n-sync.mjs --check",
    "i18n:sync:list": "node scripts/i18n-sync.mjs --check --verbose",
    "i18n:sync:baseline": "node scripts/i18n-sync.mjs --write-baseline"
  },
  "keywords": [],
  "author": "Jason Young",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/alisunstar/OpenSunstar"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.5.4",
    "code-inspector-plugin": "^2.0.7",
    "cross-fetch": "^4.1.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "flexsearch": "^0.8.212",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "jsonc-parser": "^3.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "smol-toml": "^1.7.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  }
}
